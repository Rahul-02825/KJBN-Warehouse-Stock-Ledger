# Copy to .env and fill in. .env is git-ignored; never commit real values.

# PostgreSQL connection string used by the API, migrations, seed, `sqlc vet` and docker compose.
#   docker compose, built-in database: leave empty, or use host "db" (not localhost):
#     postgres://ledger:ledger@db:5432/ledger?sslmode=disable
#   API on your machine (make run), local Postgres:
#     postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable
#   Hosted (Supabase):
#     postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# docker compose migrates and seeds whatever database this points at.
DATABASE_URL=

# HTTP port for the API (default 8080).
PORT=8080

# Database used by `go test`. Tests TRUNCATE every table, so this must be a
# throwaway database, never the one above. Leave unset to skip integration tests.
TEST_DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger_test?sslmode=disable

# Host ports for `docker compose up` (optional; change them if 3000 or 8080 is taken).
WEB_PORT=3000
API_PORT=8080
