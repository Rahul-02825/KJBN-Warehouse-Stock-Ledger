# Copy to .env and fill in. .env is git-ignored; never commit real values.

# PostgreSQL connection string used by the API, migrations and `sqlc vet`.
#
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the *Session pooler* (port 5432) or the direct connection, NOT the
# transaction pooler on port 6543: golang-migrate takes a session-level
# advisory lock and pgx uses prepared statements, neither of which work in
# transaction pooling mode. Always keep sslmode=require.
# If the password contains special characters, percent-encode them.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Local Docker Compose alternative (added in M0 scaffold):
# DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable
